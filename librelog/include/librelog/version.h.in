#ifndef LIBRELOG_VERSION_H
#define LIBRELOG_VERSION_H

#define LIBRELOG_PROJECT_NAME "@PROJECT_NAME@"

#define LIBRELOG_PROJECT_VERSION_STRING "@PROJECT_VERSION_STRING@"

#define LIBRELOG_PROJECT_GIT_BRANCH "@PROJECT_GIT_BRANCH@"

#define LIBRELOG_PROJECT_GIT_HASH "@PROJECT_GIT_HASH@"

#define LIBRELOG_PROJECT_SUMMARY_SHORT (LIBRELOG_PROJECT_NAME " v" LIBRELOG_PROJECT_VERSION_STRING)

#define LIBRELOG_PROJECT_SUMMARY_GIT (LIBRELOG_PROJECT_GIT_BRANCH "#" LIBRELOG_PROJECT_GIT_HASH)

#define LIBRELOG_PROJECT_SUMMARY (LIBRELOG_PROJECT_NAME " v" LIBRELOG_PROJECT_VERSION_STRING " (" LIBRELOG_PROJECT_GIT_BRANCH  "#" LIBRELOG_PROJECT_GIT_HASH ")")

#endif
