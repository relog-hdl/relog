#ifndef RELOG_VERSION_H
#define RELOG_VERSION_H

#define RELOG_PROJECT_NAME "@PROJECT_NAME@"

#define RELOG_PROJECT_VERSION_STRING "@PROJECT_VERSION_STRING@"

#define RELOG_PROJECT_GIT_BRANCH "@PROJECT_GIT_BRANCH@"

#define RELOG_PROJECT_GIT_HASH "@PROJECT_GIT_HASH@"

#define RELOG_PROJECT_SUMMARY_SHORT (RELOG_PROJECT_NAME " v" RELOG_PROJECT_VERSION_STRING)

#define RELOG_PROJECT_SUMMARY_GIT (RELOG_PROJECT_GIT_BRANCH "#" RELOG_PROJECT_GIT_HASH)

#define RELOG_PROJECT_SUMMARY (RELOG_PROJECT_NAME " v" RELOG_PROJECT_VERSION_STRING " (" RELOG_PROJECT_GIT_BRANCH  "#" RELOG_PROJECT_GIT_HASH ")")

#endif
